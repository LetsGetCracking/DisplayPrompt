<Window x:Class="DisplayPrompt.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display options"
        Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="#FF1C1D22"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="CardBg"        Color="#FA1C1D22"/>
        <SolidColorBrush x:Key="CardBorder"    Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TileBg"        Color="#FF2A2C33"/>
        <SolidColorBrush x:Key="TileHover"     Color="#FF33363F"/>
        <SolidColorBrush x:Key="TilePressed"   Color="#FF24262C"/>
        <SolidColorBrush x:Key="TileBorder"    Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TileActiveBg"  Color="#FF22304D"/>
        <SolidColorBrush x:Key="Accent"        Color="#FF4F8CFF"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFF3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA0AB"/>
        <SolidColorBrush x:Key="Dim"           Color="#FF5A5F6B"/>

        <!-- Option tile -->
        <Style x:Key="OptionTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{StaticResource TileBg}"
                                BorderBrush="{StaticResource TileBorder}"
                                BorderThickness="1.5"
                                Padding="12,14,12,12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileHover}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileActiveBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TilePressed}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral pill button (Hide) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="19"
                                Background="#FF3A3D46"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF464A55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF30333A"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent pill button (Apply) -->
        <Style x:Key="AccentPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="19"
                                Background="#FF4F8CFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6A9DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3F78E6"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Best quality switch (top-right) -->
        <Style x:Key="QualityToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" Background="#FF2A2C33"
                                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10,5,5,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Lbl" Text="Best quality" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="#FF4A4E59">
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White"
                                             HorizontalAlignment="Left" Margin="2,0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33363F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#664F8CFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ScreenOn" TargetType="Rectangle">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Fill" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="ScreenOff" TargetType="Rectangle">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Stroke" Value="{StaticResource Dim}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
        <Style x:Key="Stand" TargetType="Rectangle">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource Dim}"/>
        </Style>
    </Window.Resources>

    <!-- Normal (non see-through) window: Windows 11 draws the rounded corners and border -->
    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="8"/>
        </Grid.RenderTransform>

        <Border Background="{StaticResource CardBg}"
                Padding="16,18,16,16">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="4,0,4,14" Background="Transparent" Cursor="SizeAll"
                      MouseLeftButtonDown="Header_MouseDown" ToolTip="Drag to move">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="QualityToggle" Grid.Column="2" Style="{StaticResource QualityToggle}"
                                  VerticalAlignment="Top" Margin="8,0,0,0"
                                  Checked="QualityToggle_Changed" Unchecked="QualityToggle_Changed"
                                  ToolTip="When mirroring, use the highest resolution both screens support"/>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#1F4F8CFF" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/app.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="New display detected" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Text="How would you like to use it?" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Mode options -->
                <UniformGrid x:Name="ModePanel" Columns="2" Margin="-5,0,-5,0">

                    <Button x:Name="PcOnlyBtn" Style="{StaticResource OptionTile}" Click="Option_Click"
                            ToolTip="Show only on this computer's screen">
                        <StackPanel>
                            <Canvas Width="54" Height="22" HorizontalAlignment="Center">
                                <Rectangle Style="{StaticResource ScreenOn}"/>
                                <Rectangle Style="{StaticResource ScreenOff}" Canvas.Left="30"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="7" Canvas.Top="20"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="37" Canvas.Top="20"/>
                            </Canvas>
                            <TextBlock Text="This PC only" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="Main screen only" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MirrorBtn" Style="{StaticResource OptionTile}" Click="Option_Click"
                            ToolTip="Show the same thing on both screens">
                        <StackPanel>
                            <Canvas Width="54" Height="22" HorizontalAlignment="Center">
                                <Rectangle Style="{StaticResource ScreenOn}"/>
                                <Rectangle Style="{StaticResource ScreenOn}" Canvas.Left="30"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="5.5" Width="6" Height="6" Fill="White"/>
                                <Ellipse Canvas.Left="39" Canvas.Top="5.5" Width="6" Height="6" Fill="White"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="7" Canvas.Top="20"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="37" Canvas.Top="20"/>
                            </Canvas>
                            <TextBlock Text="Mirroring" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="Same on both" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExtendBtn" Style="{StaticResource OptionTile}" Click="Option_Click"
                            ToolTip="Spread your desktop across screens, then arrange them">
                        <StackPanel>
                            <Canvas Width="54" Height="22" HorizontalAlignment="Center">
                                <Rectangle Style="{StaticResource ScreenOn}"/>
                                <Rectangle Style="{StaticResource ScreenOn}" Canvas.Left="30"/>
                                <Rectangle Canvas.Left="5" Canvas.Top="7.5" Width="44" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="White" Opacity="0.9"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="7" Canvas.Top="20"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="37" Canvas.Top="20"/>
                            </Canvas>
                            <TextBlock Text="Extended" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="One big desktop" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SecondOnlyBtn" Style="{StaticResource OptionTile}" Click="Option_Click"
                            ToolTip="Show only on the new monitor or projector">
                        <StackPanel>
                            <Canvas Width="54" Height="22" HorizontalAlignment="Center">
                                <Rectangle Style="{StaticResource ScreenOff}"/>
                                <Rectangle Style="{StaticResource ScreenOn}" Canvas.Left="30"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="7" Canvas.Top="20"/>
                                <Rectangle Style="{StaticResource Stand}" Canvas.Left="37" Canvas.Top="20"/>
                            </Canvas>
                            <TextBlock Text="Second screen only" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="New display only" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Arrange view (Extended) -->
                <Border x:Name="ArrangePanel" Visibility="Collapsed"
                        Height="200" CornerRadius="12"
                        Background="#FF141518" BorderBrush="{StaticResource TileBorder}" BorderThickness="1">
                    <Canvas x:Name="LayoutCanvas" ClipToBounds="True" Background="Transparent"/>
                </Border>

                <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="4,10,4,0"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>

                <!-- Auto-hide countdown -->
                <Border x:Name="CountdownTrack" Height="3" CornerRadius="1.5" Background="#1AFFFFFF" Margin="6,14,6,0">
                    <Border CornerRadius="1.5" Background="{StaticResource Accent}"
                            Opacity="0.85" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <!-- Buttons -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HideBtn" Grid.Column="0" Grid.ColumnSpan="3" Content="Hide"
                            Style="{StaticResource PillButton}" Click="Hide_Click" IsCancel="True"/>
                    <Button x:Name="ApplyBtn" Grid.Column="2" Content="Apply" Visibility="Collapsed"
                            Style="{StaticResource AccentPillButton}" Click="Apply_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
